# Server
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# MongoDB — replace with your own Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/your_db_name
MONGODB_URI_TEST=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/your_db_name_test

# Redis (optional — leave blank to run without cache, app works fine without it)
REDIS_URL=
REDIS_PASSWORD=

# JWT — generate strong random strings for production
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_minimum_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Game Config
BATTLE_TIMEOUT_MS=30000
MATCHMAKING_TIMEOUT_MS=60000
MAX_MONSTERS_PER_USER=300
MAX_TEAM_SIZE=6

# Admin
ADMIN_SECRET_KEY=change_this_in_production

# Logging
LOG_LEVEL=info
ENABLE_FILE_LOGS=false
